/**
 * Generates supabase/seed.sql and the Edge Function's exercise catalog from the app's bundled
 * catalog so the database, the coach and the app always agree on exercise IDs.
 *
 *   npm run generate:seed      (Node 22.18+ runs TypeScript directly)
 */
import { mkdirSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { EXERCISES, MUSCLE_GROUPS } from '../src/features/exercises/catalog.ts';

const root = join(dirname(fileURLToPath(import.meta.url)), '..');

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const arr = (items: string[]) => (items.length ? `array[${items.map(q).join(', ')}]::text[]` : `'{}'::text[]`);

const lines: string[] = [
  '-- Generated by scripts/generate-seed.mts from src/features/exercises/catalog.ts — do not edit by hand.',
  '',
  'insert into public.muscle_groups (id, name, sort_order) values',
  MUSCLE_GROUPS.map((g, i) => `  (${q(g)}, ${q(g[0].toUpperCase() + g.slice(1))}, ${i})`).join(',\n') +
    '\non conflict (id) do update set name = excluded.name, sort_order = excluded.sort_order;',
  '',
  'insert into public.exercises (id, name, muscle_group_id, primary_muscle, secondary_muscles, type, difficulty, description, instructions, tips, recommended_sets, recommended_reps, rest_seconds, is_timed, is_bodyweight, image_path) values',
  EXERCISES.map(
    (e) =>
      `  (${q(e.id)}, ${q(e.name)}, ${q(e.muscleGroup)}, ${q(e.primaryMuscle)}, ${arr(e.secondaryMuscles)}, ${q(e.type)}, ${q(e.difficulty)}, ${q(e.description)}, ${arr(e.instructions)}, ${arr(e.tips)}, ${e.recommended.sets}, ${q(e.recommended.reps)}, ${e.recommended.restSeconds}, ${Boolean(e.isTimed)}, ${Boolean(e.isBodyweight)}, ${q(`${e.slug}.jpg`)})`,
  ).join(',\n') +
    `\non conflict (id) do update set
  name = excluded.name, muscle_group_id = excluded.muscle_group_id, primary_muscle = excluded.primary_muscle,
  secondary_muscles = excluded.secondary_muscles, type = excluded.type, difficulty = excluded.difficulty,
  description = excluded.description, instructions = excluded.instructions, tips = excluded.tips,
  recommended_sets = excluded.recommended_sets, recommended_reps = excluded.recommended_reps,
  rest_seconds = excluded.rest_seconds, is_timed = excluded.is_timed, is_bodyweight = excluded.is_bodyweight,
  image_path = excluded.image_path;`,
  '',
  'insert into public.exercise_equipment (exercise_id, equipment) values',
  EXERCISES.flatMap((e) => e.equipment.map((eq) => `  (${q(e.id)}, ${q(eq)})`)).join(',\n') + '\non conflict do nothing;',
  '',
];

writeFileSync(join(root, 'supabase', 'seed.sql'), lines.join('\n'));

const catalog = EXERCISES.map((e) => ({
  id: e.id,
  name: e.name,
  group: e.muscleGroup,
  primary: e.primaryMuscle,
  equipment: e.equipment,
  type: e.type,
  difficulty: e.difficulty,
  sets: e.recommended.sets,
  reps: e.recommended.reps,
}));
const fnDir = join(root, 'supabase', 'functions', '_shared');
mkdirSync(fnDir, { recursive: true });
writeFileSync(
  join(fnDir, 'exercise-catalog.ts'),
  `// Generated by scripts/generate-seed.mts — do not edit by hand.\nexport const EXERCISE_CATALOG = ${JSON.stringify(catalog, null, 2)} as const;\n\nexport const EXERCISE_IDS = EXERCISE_CATALOG.map((e) => e.id);\n`,
);

console.log(`Seed: ${MUSCLE_GROUPS.length} muscle groups, ${EXERCISES.length} exercises.`);
