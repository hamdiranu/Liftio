# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values are bundled into the app,
# so never put secret keys (Anthropic, service-role) here — those live in Supabase secrets.

# Supabase project (Project settings -> API). Leave empty to run fully offline in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI coach provider: "local" (on-device rule engine, works offline) or "edge"
# (Supabase Edge Function `ai-coach`, which holds the model API key server-side).
EXPO_PUBLIC_AI_PROVIDER=local

# Optional: public bucket that holds exercise photos as <slug>.jpg (see assets/images/README.md).
EXPO_PUBLIC_EXERCISE_IMAGE_BUCKET=exercise-images
